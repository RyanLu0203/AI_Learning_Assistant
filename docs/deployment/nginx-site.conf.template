# Replace __DOMAIN__ and create the dedicated password file before enabling.
# Certbot subsequently adds TLS and the HTTP-to-HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    client_max_body_size 50m;

    location / {
        auth_basic "BA3073 AI Learning Assistant";
        auth_basic_user_file /etc/nginx/ai-learning-assistant.htpasswd;

        proxy_pass http://127.0.0.1:14242;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
        proxy_buffering off;
    }
}
